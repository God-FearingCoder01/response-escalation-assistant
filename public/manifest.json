{
  "manifest_version": 3,
  "name": "Response & Escalation Assistant",
  "version": "1.0.0",
  "description": "REA side panel extension",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "REA.png",
    "32": "REA.png",
    "48": "REA.png",
    "128": "REA.png"
  },
  "action": {
    "default_title": "Open REA",
    "default_icon": "REA.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
