{
  "manifest_version": 3,
  "name": "REA",
  "version": "1.0.0",
  "description": "Response and Escalation Assistant",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://web.telegram.org/*",
    "https://mail.google.com/*",
    "https://*.tawk.to/*",
    "https://*.winbucks.co.zw/*",
    "https://usd-win.betfounders.com/*",
    "https://response-escalation-assistant.vercel.app/*"
  ],
  "icons": {
    "16": "icon128.png",
    "32": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open REA",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://*.facebook.com/*",
        "https://*.messenger.com/*",
        "https://web.telegram.org/*",
        "https://mail.google.com/*",
        "https://*.tawk.to/*",
        "https://*.winbucks.co.zw/*",
        "https://usd-win.betfounders.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
