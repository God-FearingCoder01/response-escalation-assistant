{
  "manifest_version": 3,
  "name": "REA",
  "version": "1.0.0",
  "description": "Response and Escalation Assistant",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "REA.png",
    "32": "REA.png",
    "48": "REA.png",
    "128": "REA.png"
  },
  "action": {
    "default_title": "Open REA",
    "default_icon": "REA.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
