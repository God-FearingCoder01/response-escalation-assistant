# Database Persistence Configuration
# ----------------------------------
# Production Persistence (PostgreSQL):
# Set DATABASE_URL or POSTGRES_URL to your production PostgreSQL connection string (Neon, Supabase, Vercel Postgres, AWS RDS, etc.)
# Example: DATABASE_URL=postgresql://user:password@ep-example-123.region.aws.neon.tech/rea_db?sslmode=require

# Local Development Persistence (SQLite):
# Leave DATABASE_URL commented out to automatically use local SQLite (backend/backend_data.db)
# DATABASE_URL=sqlite:///backend_data.db

# Environment Mode ("production" or "development")
ENVIRONMENT=development

# Admin & Session Security Secrets
SECRET_KEY=rea_admin_secret_key_v1_change_in_production
ADMIN_SESSION_EXPIRE_HOURS=12

# Required private four-digit bootstrap PINs (never use 0000).
SUPERADMIN_BOOTSTRAP_PIN=
AGENT_BOOTSTRAP_PIN=
PIN_PEPPER=
CORS_ALLOWED_ORIGINS=
CHROME_EXTENSION_ID=

# Default Tenant Configuration
DEFAULT_COMPANY_NAME=Default
DEFAULT_COMPANY_SLUG=default

# Ask REA (AI assistant) -- server-side only. Keys are read by the backend and are never
# sent to the browser or the Chrome extension. Never commit real keys: set them in the
# untracked .env file locally and in the Vercel dashboard for production.
# Leave every key empty to keep Ask REA switched off.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Order in which providers are tried; the next one is used if a provider fails.
ASK_REA_PROVIDERS=gemini,openai,anthropic
# Optional model overrides (check current model names in each provider's docs).
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Optional limits. Set ASK_REA_ENABLED=false to switch the feature off without removing keys.
ASK_REA_ENABLED=true
ASK_REA_HOURLY_LIMIT=30
